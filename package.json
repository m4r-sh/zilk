{
  "version": "0.9.0",
  "name": "zilk",
  "description": "lightweight and flexible web framework",
  "author": {
    "name": "m4rsh",
    "email": "me@m4r.sh",
    "url": "https://m4rsh.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/m4r-sh/zilk.git"
  },
  "files": [
     "dist",
     "README.md",
     "docs/API.md",
     "license",
     "index.d.ts"
  ],
  "types": "./index.d.ts",
  "typesVersions": {
    "*": {
      "*": ["index.d.ts"]
    }
  },
  "scripts": {
    "build": "bun run build:hydrate && bun run build:fetch && bun run build:nav && bun run build:navigation && bun run build:dom && bun run build:ssr",
    "build:hydrate": "bun build --outfile dist/hydrate.js --target=browser --minify ./src/hydrate/index.js",
    "build:fetch": "bun build --outfile dist/fetch.js --target=browser --minify ./src/fetch/index.js",
    "build:nav": "bun build --outfile dist/nav.js --target=browser --minify ./src/nav/index.js",
    "build:navigation": "bun build --outfile dist/navigation.js --target=browser --minify ./src/navigation/index.js",
    "build:dom": "bun build --outfile dist/dom.js --target=browser --minify ./src/dom.js",
    "build:ssr": "bun build --outfile dist/ssr.js --target=browser --minify ./src/ssr.js"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "bun": "./dist/ssr.js",
      "node": "./dist/ssr.js",
      "worker": "./dist/ssr.js",
      "browser": "./dist/dom.js",
      "default": "./dist/dom.js"
    },
    "./ssr": {
      "types": "./index.d.ts",
      "default": "./dist/ssr.js"
    },
    "./dom": {
      "types": "./index.d.ts",
      "default": "./dist/dom.js"
    },
    "./hydrate": {
      "types": "./index.d.ts",
      "browser": "./dist/hydrate.js",
      "default": "./dist/hydrate.js"
    },
    "./nav": {
      "types": "./index.d.ts",
      "browser": "./dist/nav.js",
      "default": "./dist/nav.js"
    },
    "./navigation": {
      "types": "./index.d.ts",
      "browser": "./dist/navigation.js",
      "default": "./dist/navigation.js"
    },
    "./fetch": {
      "types": "./index.d.ts",
      "bun": "./dist/fetch.js",
      "node": "./dist/fetch.js",
      "worker": "./dist/fetch.js",
      "browser": "./dist/fetch.js",
      "default": "./dist/fetch.js"
    }
  },
  "dependencies": {
    "@m4rsh/cones": "^1.2.1",
    "itty-router": "^5.0.18",
    "uhtml": "^4.7.0",
    "uhtml-ssr": "^0.9.1",
    "wicked-elements": "^3.1.2"
  }
}
